entrypoint = "server/index.js"
modules = ["nodejs-22", "web"]
run = "npm run build && npm start"

[env]
PORT = "8787"

[deployment]
deploymentTarget = "cloudrun"
build = "npm ci --include=dev && npm run build"
run = "npm start"

[[ports]]
localPort = 8787
externalPort = 80

[nix]
channel = "stable-25_05"
